"""Tests for product creation, retrieval, and update."""


def test_create_product(client):
    response = client.post(
        "/products",
        json={"name": "Wireless Mouse", "category": "Electronics", "price": "29.99"},
    )
    assert response.status_code == 201
    body = response.json()
    assert body["name"] == "Wireless Mouse"
    assert body["category"] == "Electronics"
    assert "id" in body
    assert body["created_at"] is not None
    assert body["updated_at"] is not None


def test_get_product(client):
    create = client.post(
        "/products",
        json={"name": "Desk Lamp", "category": "Home", "price": "45.00"},
    )
    product_id = create.json()["id"]

    response = client.get(f"/products/{product_id}")
    assert response.status_code == 200
    assert response.json()["name"] == "Desk Lamp"


def test_get_product_not_found(client):
    response = client.get("/products/999999")
    assert response.status_code == 404


def test_update_product_changes_updated_at(client):
    create = client.post(
        "/products",
        json={"name": "Yoga Mat", "category": "Sports", "price": "20.00"},
    )
    product_id = create.json()["id"]
    original_updated_at = create.json()["updated_at"]

    update = client.put(f"/products/{product_id}", json={"price": "25.00"})
    assert update.status_code == 200
    body = update.json()
    assert float(body["price"]) == 25.00
    # updated_at must move forward (never go backwards, never stay identical
    # to a stale value the client might be holding).
    assert body["updated_at"] >= original_updated_at


def test_update_product_partial(client):
    create = client.post(
        "/products",
        json={"name": "Tea Set", "category": "Grocery", "price": "30.00"},
    )
    product_id = create.json()["id"]

    update = client.put(f"/products/{product_id}", json={"name": "Premium Tea Set"})
    assert update.status_code == 200
    body = update.json()
    assert body["name"] == "Premium Tea Set"
    assert body["category"] == "Grocery"  # untouched field preserved


def test_update_product_not_found(client):
    response = client.put("/products/999999", json={"price": "10.00"})
    assert response.status_code == 404


def test_create_product_validates_price(client):
    response = client.post(
        "/products",
        json={"name": "Broken Item", "category": "Toys", "price": "-5.00"},
    )
    assert response.status_code == 422
